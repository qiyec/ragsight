<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.qiyec.ragsight</groupId>
    <artifactId>ragsight-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ragsight-web</artifactId>
  <name>ragsight :: web</name>
  <description>
    Web 层：HTTP 接口 + 单页前端。让人能在浏览器里调参数、看热力图。

    为什么引入 Spring Boot，见 docs/adr/005-web-layer-and-spring-boot.md。
    边界：domain 和 application 仍然零第三方依赖，由架构测试守住。
    这一层只是换了个人机界面，不改变诊断逻辑——
    结论仍然由固定规则推导，不经过大模型。
  </description>

  <dependencies>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-application</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-infrastructure</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-diagnosis</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 网页上的"让 Agent 自己找瓶颈"入口要用它 -->
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-agent</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Web 服务。静态资源托管、JSON 编解码、依赖注入都由它提供 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ragsight-web</finalName>
    <plugins>
      <!--
        打成可以直接 java -jar 启动的可执行 jar。

        关键在 classifier="exec"：默认行为是把可执行胖包**替换**成主产物，
        那样会出两个问题：

        1. 架构测试的 ArchUnit 读不了胖包——类被挪到了 BOOT-INF/classes 下，
           规则会报 "failed to check any classes"（这个坑真实踩到过）。
        2. 别的模块把它当依赖时同样读不到里面的类。

        加上 classifier 之后，主产物仍是普通薄 jar（ArchUnit 和依赖方都能读），
        可执行胖包另存为 ragsight-web-exec.jar。

        运行命令因此是：
          java -jar ragsight-web/target/ragsight-web-exec.jar
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        这里曾经有一段：打包后把 jar 复制一份到 ragsight-cli/target/，
        让两个入口在同一个目录里，README 的路径能统一。

        撤掉了，因为它带来的麻烦大于便利：
        服务运行时 jar 被占用，复制过去的那个文件删不掉，
        于是 **mvnw clean verify 会直接失败**（clean 插件删不掉文件）。
        为了少写几行路径而让构建失败，不值得。
      -->
    </plugins>
  </build>
</project>
