<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.qiyec.ragsight</groupId>
  <artifactId>ragsight-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ragsight</name>
  <description>RAG 质量诊断与调优工作台：定位检索增强生成的真实瓶颈</description>

  <modules>
    <module>ragsight-domain</module>
    <module>ragsight-application</module>
    <module>ragsight-infrastructure</module>
    <module>ragsight-cli</module>
    <module>ragsight-web</module>
    <module>ragsight-diagnosis</module>
    <module>ragsight-agent</module>
    <module>ragsight-architecture-tests</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <junit.version>5.10.2</junit.version>
    <assertj.version>3.25.3</assertj.version>
    <archunit.version>1.3.0</archunit.version>
    <slf4j.version>2.0.17</slf4j.version>
    <picocli.version>4.7.6</picocli.version>
    <jackson.version>2.17.3</jackson.version>
    <!--
      日志版本故意和 Spring Boot 3.5.9 对齐（见它的 spring-boot-dependencies）。
      曾经把 logback 写死成 1.5.6，和 Spring Boot 要的版本不兼容，
      启动时报 AbstractMethodError（PatternLayout 缺方法）。

      这种「两套依赖管理打架」的问题编译期完全看不出来，只在启动时炸。
      所以宁可跟着 Spring Boot 的版本走——logback 本来就是它自己在用的东西。
    -->
    <logback.version>1.5.22</logback.version>
    <!--
      AgentScope 用 2.0.4 而不是最新的 2.1.0-BETA1：这是要给别人用的项目，
      不适合押在 BETA 上。升级只需改这一行。
    -->
    <agentscope.version>2.0.4</agentscope.version>
    <!--
      Spring Boot 只用在 ragsight-web 和将来的 Agent 层。
      选 3.5.9 而不是最新的 3.5.16，是因为本地 Maven 仓库已有缓存，
      首次构建不用等下载。升级只需改这一行。
    -->
    <spring-boot.version>3.5.9</spring-boot.version>

    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
    <maven.jar.plugin.version>3.4.1</maven.jar.plugin.version>
    <maven.shade.plugin.version>3.5.3</maven.shade.plugin.version>
    <maven.enforcer.plugin.version>3.4.1</maven.enforcer.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        本项目自己的模块也在这里声明一遍。

        不只是为了省掉各模块 pom 里的 version，更重要的是让 Maven
        能算对构建顺序：模块之间的依赖如果只在子 pom 里写，
        跨模块时反应堆顺序会排错（出现过 agent 排在它依赖的 web 前面，
        直接编译失败）。在这里声明之后 Maven 一眼就能看出谁依赖谁。
      -->
      <dependency>
        <groupId>cn.qiyec.ragsight</groupId>
        <artifactId>ragsight-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.qiyec.ragsight</groupId>
        <artifactId>ragsight-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.qiyec.ragsight</groupId>
        <artifactId>ragsight-infrastructure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.qiyec.ragsight</groupId>
        <artifactId>ragsight-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.qiyec.ragsight</groupId>
        <artifactId>ragsight-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.qiyec.ragsight</groupId>
        <artifactId>ragsight-diagnosis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.qiyec.ragsight</groupId>
        <artifactId>ragsight-agent</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        Spring Boot 的依赖管理。用 import 而不是把 spring-boot-starter-parent
        当父 POM，是因为本项目自己的父 POM 已经管了很多东西
        （编译参数、Enforcer、插件版本），换父 POM 会把它们全顶掉。
      -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        AgentScope 的版本管理。同样是 import 方式，不换父 POM。
        它必须排在 Spring Boot 之后：AgentScope 自己也依赖 Spring，
        让 Spring Boot 的版本先定下来，再由 AgentScope 补充它独有的那些，
        两边的版本才不会被顶掉。
      -->
      <dependency>
        <groupId>io.agentscope</groupId>
        <artifactId>agentscope-bom</artifactId>
        <version>${agentscope.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <!--
        Jackson 只用在基础设施层：调真实向量模型接口时收发 JSON。
        domain 层不许引它，有架构测试盯着。
      -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven.jar.plugin.version}</version>
          <configuration>
            <archive>
              <manifest>
                <!-- 把解析后的版本写入 manifest，供 CLI 输出版本号时使用 -->
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven.shade.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- 统一 JDK 与 Maven 版本门槛，避免 clone 后因环境差异构建失败 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[17,)</version>
                  <message>ragsight 需要 JDK 17 及以上。请设置 JAVA_HOME 指向 JDK 17+（参见 docs/setup/environment.md）。</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.8.0,)</version>
                  <message>ragsight 需要 Maven 3.8.0 及以上。</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
