<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.qiyec.ragsight</groupId>
    <artifactId>ragsight-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ragsight-architecture-tests</artifactId>
  <name>ragsight :: architecture-tests</name>
  <description>
    架构约束的自动化守护。用 ArchUnit 断言 AGENTS.md 中的铁律，违反即构建失败。

    为什么单独成模块：ArchUnit 是测试依赖，若放进 ragsight-domain 会违反
    R1（domain 零第三方依赖）。单独成模块后，可以在不污染 domain 的前提下
    校验 domain 的依赖边界。
  </description>

  <dependencies>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-domain</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-application</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
