<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.qiyec.ragsight</groupId>
    <artifactId>ragsight-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ragsight-architecture-tests</artifactId>
  <name>ragsight :: architecture-tests</name>
  <description>
    架构约束的自动化守护。用 ArchUnit 断言 AGENTS.md 中的铁律，违反即构建失败。

    为什么单独成模块：ArchUnit 是测试依赖，若放进 ragsight-domain 会违反
    R1（domain 零第三方依赖）。单独成模块后，可以在不污染 domain 的前提下
    校验 domain 的依赖边界。
  </description>

  <dependencies>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-domain</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-application</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      下面三个也要在测试 classpath 上，否则 ArchUnit 扫不到那些包，
      规则会静默失效——构建照样通过，但实际什么都没检查。
      这种"以为有门禁、其实没有"的状态比没有门禁更危险。
      架构测试模块自己的 ArchGateSelfCheckTest 就在防这类问题。

      注：这些依赖只是为了让 ArchUnit **看得到**那些模块的类，
      不需要把它们的功能跑起来，所以都带 test scope。
    -->
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-diagnosis</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-infrastructure</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-web</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-agent</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
      <!--
        把 AgentScope 的传递依赖挡在外面。
        一是没必要（规则只看包名，不跑功能），
        二是这里有个真实冲突：项目固定了 logback 1.5.22，
        而 AgentScope 的依赖树会带进它自己的版本，两个版本在
        classpath 上打架会让架构测试模块的日志初始化出错。
      -->
      <exclusions>
        <exclusion>
          <groupId>io.agentscope</groupId>
          <artifactId>agentscope-core</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.agentscope</groupId>
          <artifactId>agentscope-extensions-model-dashscope</artifactId>
        </exclusion>
        <exclusion>
          <groupId>ch.qos.logback</groupId>
          <artifactId>logback-classic</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
