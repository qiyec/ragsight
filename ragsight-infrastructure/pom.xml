<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>cn.qiyec.ragsight</groupId>
    <artifactId>ragsight-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ragsight-infrastructure</artifactId>
  <name>ragsight :: infrastructure</name>
  <description>
    适配器层：实现 domain 定义的端口（Embedding / VectorStore / Reranker / DocumentReader）。
    默认提供零外部依赖的离线实现（确定性哈希 Embedding、内存向量库、词法重排），
    保证 clone 后无需任何配置即可 mvn verify 全绿。
    真实模型 / 向量库 / 文档格式的适配器以可选依赖形式引入。
  </description>

  <dependencies>
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      依赖 application 的原因：infrastructure 需要实现 application 定义的
      RetrieverFactory 端口（驱动适配器）。依赖方向仍是
      infrastructure -> application -> domain，未违反铁律 R2。
    -->
    <dependency>
      <groupId>cn.qiyec.ragsight</groupId>
      <artifactId>ragsight-application</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- 调真实向量模型接口时收发 JSON 用。只在基础设施层，domain 不许引它 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
