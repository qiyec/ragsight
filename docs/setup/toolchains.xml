<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven Toolchains 配置模板。

  作用：让 Maven 按 <release> 声明去选 JDK，而不是依赖 PATH 里第一个 java。
  这样命令行构建与 IDEA 里手工选的 JDK 行为一致，不受 PATH 顺序影响。

  使用方式：
    复制到  C:\Users\<你的用户名>\.m2\toolchains.xml

  说明：
    - ragsight 默认要求 JDK 17，因此 jdk 17 条目是必需的。
    - jdk 21 可选保留，将来某模块需要更高版本时可直接在 pom 里改 <release>。
    - 只有本文件存在时，ragsight 的 toolchains profile 才会激活；
      没有本文件时构建自动跳过该插件，因此不影响"clone 即可跑"。
-->
<toolchains xmlns="http://maven.apache.org/TOOLCHAINS/1.1.0"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://maven.apache.org/TOOLCHAINS/1.1.0 http://maven.apache.org/xsd/toolchains-1.1.0.xsd">

  <toolchain>
    <type>jdk</type>
    <provides>
      <version>17</version>
      <vendor>temurin</vendor>
    </provides>
    <configuration>
      <jdkHome>D:\develop\environment\JDK\jdk-17.0.14+7</jdkHome>
    </configuration>
  </toolchain>

  <toolchain>
    <type>jdk</type>
    <provides>
      <version>21</version>
      <vendor>temurin</vendor>
    </provides>
    <configuration>
      <jdkHome>D:\develop\environment\JDK\jdk-21.0.7+6</jdkHome>
    </configuration>
  </toolchain>

</toolchains>
